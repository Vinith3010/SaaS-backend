# Environment Configuration for Backend Server

# Gemini AI (from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=

# Google OAuth 2.0 & Gmail API (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Database & Authentication
MONGODB_URI=mongodb://127.0.0.1:27017/saas_dashboard
JWT_SECRET=super_secret_jwt_key_saas_analytics_2026_prod

# Application & Frontend URLs
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Nodemailer / SMTP Email Alerts (Optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
